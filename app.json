{
  "expo": {
    "name": "Gravity Flip",
    "slug": "gravity-flip",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "gravityflip",
    "splash": {
      "backgroundColor": "#0a0a1f",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mikepitts25.gravityflip"
    },
    "android": {
      "package": "com.mikepitts25.gravityflip",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a1f"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-av"]
  }
}
